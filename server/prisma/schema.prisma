generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  passwordHash     String
  role             String    @default("ADMIN")
  createdAt        DateTime  @default(now())
  refreshToken     String?
  resetToken       String?
  resetTokenExpiry DateTime?
}

model ProductCategory {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Product {
  id          Int             @id @default(autoincrement())
  title       String
  description String?
  price       Decimal         @db.Decimal(10, 2)
  imageUrl    String
  categoryId  Int
  createdAt   DateTime        @default(now())
  category    ProductCategory @relation(fields: [categoryId], references: [id])
}

model PortfolioCategory {
  id     Int              @id @default(autoincrement())
  name   String           @unique
  albums PortfolioAlbum[]
}

model PortfolioAlbum {
  id         Int               @id @default(autoincrement())
  title      String
  clientName String?
  coverImage String
  categoryId Int
  createdAt  DateTime          @default(now())
  category   PortfolioCategory @relation(fields: [categoryId], references: [id])
  images     PortfolioImage[]
}

model PortfolioImage {
  id       Int            @id @default(autoincrement())
  imageUrl String
  albumId  Int
  album    PortfolioAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id         Int      @id @default(autoincrement())
  name       String
  profession String?
  comment    String
  rating     Int      @default(5)
  imageUrl   String?
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StudioSettings {
  id           Int      @id @default(1)
  address      String?
  workingHours String?
  phone        String?
  email        String?
  instagram    String?
  facebook     String?
  whatsapp     String?
  youtube      String?
  updatedAt    DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model n8n_chat_histories {
  id         Int    @id @default(autoincrement())
  session_id String @db.VarChar(255)
  message    Json
}
